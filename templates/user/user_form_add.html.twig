{% extends 'base/base_admin.html.twig' %}

{% block title %} Ajouter un utilisateur{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="form">
            {{ form_start(add_user_form, {'attr': {'novalidate': 'novalidate'}}) }}

            {% if not add_user_form.vars.valid %}
                <div class="alert alert-danger" role="alert">
                    {{ 'users.validation.form.invalid'|trans }}
                </div>
            {% endif %}

            <div class="row">
                <div class="col col-12 col-md-6">{{ form_row(add_user_form.firstName) }}</div>
                <div class="col col-12 col-md-6">{{ form_row(add_user_form.lastName) }}</div>
            </div>

            <div class="row">
                <div class="col col-12 col-md-6">{{ form_row(add_user_form.email) }}</div>
                <div class="col col-12 col-md-6">{{ form_row(add_user_form.role) }}</div>
            </div>

            <div class="row">
                <div class="col col-12 col-md-6">{{ form_row(add_user_form.password) }}</div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">{{ 'users.form.button.submit_add'|trans }}</button>
            </div>
            {{ form_end(add_user_form) }}
        </div>

    </div>

{% endblock %}
